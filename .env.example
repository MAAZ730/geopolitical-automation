# Core AI providers (used by main.py and antigravity/main.py)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Optional Instagram/third-party scraping providers
APIFY_TOKEN=your-apify-token
APIFY_TOKEN_NEW=your-secondary-apify-token
SCRAPE_CREATORS_API_KEY=your-rapidapi-scrape-creators-key

# Google Drive auth (set one or both depending on your auth method)
# JSON string for OAuth user token payload
GOOGLE_OAUTH_TOKEN_JSON={"client_id":"...","client_secret":"...","refresh_token":"...","token":"...","token_uri":"https://oauth2.googleapis.com/token"}
# JSON string for service-account credentials payload
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Drive folder routing
# Parent folder ID for run folders (optional; defaults to My Drive root)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-parent-folder-id
# Reserved for future video-only routing
VIDEO_DRIVE_FOLDER_ID=optional-video-folder-id

# Local OAuth helper (exchange.py)
GOOGLE_OAUTH_AUTH_CODE=one-time-oauth-code
